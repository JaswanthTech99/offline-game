{
  "name": "shatterpoint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint src tools e2e playwright.config.ts --max-warnings=0",
    "budget": "node tools/budget.mjs",
    "silhouettes": "node tools/silhouettes.mjs",
    "test": "playwright test",
    "test:gates": "playwright test e2e/gates",
    "test:visual": "playwright test e2e/visual",
    "export:4k": "playwright test e2e/gates/export4k.spec.ts --grep @export4k",
    "report": "playwright show-report e2e-report",
    "icons": "node tools/icon-variants.mjs && node tools/icon-render.mjs",
    "icons:gate": "node tools/icon-gate.mjs",
    "mobile:sync": "SP_MOBILE=1 vite build && cap sync android && node tools/icon-android.mjs",
    "mobile:apk": "npm run mobile:sync && cd android && ./gradlew assembleDebug",
    "icons:android": "node tools/icon-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@dimforge/rapier3d-compat": "0.20.0",
    "gsap": "3.15.0",
    "idb": "8.0.3",
    "motion": "13.1.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^20.19.43",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.185.4",
    "eslint": "9.39.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-wasm": "3.6.0"
  }
}
