n  --safe-r: env(safe-area-inset-right, 0px);\n  --safe-b: env(safe-area-inset-bottom, 0px);\n  --safe-l: env(safe-area-inset-left, 0px);\n  --gutter: 18px;\n  --pad-t: calc(var(--safe-t) + var(--gutter));\n  --pad-r: calc(var(--safe-r) + var(--gutter));\n  --pad-b: calc(var(--safe-b) + var(--gutter));\n  --pad-l: calc(var(--safe-l) + var(--gutter));\n  --a: var(--ice);\n  --rgb-a: var(--rgb-ice);\n  --a-lift: 1;\n}\n[data-accent='ice'] {\n  --a: var(--ice);\n  --rgb-a: var(--rgb-ice);\n}\n[data-accent='flare'] {\n  --a: var(--flare);\n  --rgb-a: var(--rgb-flare);\n}\n[data-accent='prism'] {\n  --a: var(--prism);\n  --rgb-a: var(--rgb-prism);\n}\n[data-accent='gold'] {\n  --a: var(--gold);\n  --rgb-a: var(--rgb-gold);\n}\n[data-rarity] {\n  --a: var(--prism);\n  @supports (color: color-mix(in lab, red, red)) {\n    --a: color-mix(in oklab, var(--prism) calc(var(--a-lift) * 100%), var(--ink-dim));\n  }\n  --rgb-a: var(--rgb-prism);\n}\n[data-rarity='common'] {\n  --a-lift: 0;\n}\n[data-rarity='rare'] {\n  --a-lift: 0.45;\n}\n[data-rarity='epic'] {\n  --a-lift: 0.75;\n}\n[data-rarity='mythic'] {\n  --a-lift: 1;\n}\n@layer components {\n  .a-fill {\n    color: var(--a);\n  }\n  .a-bg {\n    background-color: rgb(var(--rgb-a) / calc(0.16 * var(--a-lift)));\n  }\n  .a-glow {\n    box-shadow: 0 0 24px 0 rgb(var(--rgb-a) / calc(0.45 * var(--a-lift)));\n  }\n  .a-halo {\n    position: relative;\n    isolation: isolate;\n  }\n  .a-halo::before {\n    content: '';\n    position: absolute;\n    inset: -32px;\n    z-index: -1;\n    pointer-events: none;\n    border-radius: inherit;\n    background: radial-gradient( closest-side, rgb(var(--rgb-a) / calc(0.38 * var(--a-lift))), rgb(var(--rgb-a) / calc(0.1 * var(--a-lift))) 55%, transparent 100% );\n    filter: blur(calc(var(--glass-blur) * 1.15));\n    opacity: var(--a-lift);\n  }\n  .a-focus:focus-visible, .hit:focus-visible {\n    outline: 2px solid var(--a);\n    outline-offset: 2px;\n  }\n  .meter {\n    position: relative;\n    overflow: hidden;\n    background: rgb(var(--rgb-a) / 0.1);\n    border-radius: var(--r-chip);\n  }\n  .meter__fill {\n    --fill: 0;\n    position: absolute;\n    inset: 0;\n    transform-origin: 0 50%;\n    transform: scaleX(var(--fill));\n    background: linear-gradient(90deg, rgb(var(--rgb-a) / 0.55), var(--a));\n    will-change: transform;\n  }\n  .seam {\n    height: 1px;\n    border: 0;\n    margin: 0;\n    background: linear-gradient( 90deg, transparent, rgb(var(--rgb-a) / calc(0.5 * var(--a-lift))) 22%, rgb(var(--rgb-a) / calc(0.5 * var(--a-lift))) 78%, transparent );\n  }\n  .seam[data-vertical] {\n    height: auto;\n    width: 1px;\n    background: linear-gradient( 180deg, transparent, rgb(var(--rgb-a) / calc(0.5 * var(--a-lift))) 22%, rgb(var(--rgb-a) / calc(0.5 * var(--a-lift))) 78%, transparent );\n  }\n  .timer {\n    --t: 0;\n    aspect-ratio: 1;\n    border-radius: var(--r-round);\n    background: conic-gradient(from -90deg, var(--a) calc(var(--t) * 360deg), transparent 0), radial-gradient(closest-side, var(--void-100) 68%, transparent 69%);\n  }\n  .glass {\n    position: relative;\n    background: var(--glass);\n    border: 1px solid var(--glass-line);\n    border-radius: var(--r-panel);\n    box-shadow: 0 12px 32px -12px var(--shadow);\n    backdrop-filter: blur(var(--glass-blur)) saturate(1.25);\n    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(1.25);\n  }\n  .glass::before {\n    content: '';\n    position: absolute;\n    inset: 0 0 auto 0;\n    height: 1px;\n    pointer-events: none;\n    background: linear-gradient(90deg, transparent, var(--glass-edge) 18%, var(--glass-edge) 82%, transparent);\n  }\n  .glass[data-deep='true'] {\n    background: var(--glass-deep);\n  }\n  .t-display {\n    font-family: var(--font-display-stack);\n    font-weight: 800;\n    letter-spacing: 0.01em;\n    line-height: 1.05;\n  }\n  .t-ui {\n    font-family: var(--font-ui-stack);\n    font-weight: 500;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    line-height: 1.15;\n  }\n  .t-num {\n    font-family: var(--font-mono-stack);\n    font-variant-numeric: tabular-nums slashed-zero;\n    font-feature-settings: 'tnum' 1, 'zero' 1;\n    letter-spacing: 0;\n    line-height: 1;\n  }\n}\n@property --tw-scale-x {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-scale-y {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-scale-z {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 1;\n}\n@property --tw-rotate-x {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-rotate-y {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-rotate-z {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-skew-x {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-skew-y {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-border-style {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: solid;\n}\n@property --tw-ordinal {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-slashed-zero {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-numeric-figure {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-numeric-spacing {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-numeric-fraction {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-shadow {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0 0 #0000;\n}\n@property --tw-shadow-color {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-shadow-alpha {\n  syntax: \"<percentage>\";\n  inherits: false;\n  initial-value: 100%;\n}\n@property --tw-inset-shadow {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0 0 #0000;\n}\n@property --tw-inset-shadow-color {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-inset-shadow-alpha {\n  syntax: \"<percentage>\";\n  inherits: false;\n  initial-value: 100%;\n}\n@property --tw-ring-color {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-ring-shadow {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0 0 #0000;\n}\n@property --tw-inset-ring-color {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-inset-ring-shadow {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0 0 #0000;\n}\n@property --tw-ring-inset {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-ring-offset-width {\n  syntax: \"<length>\";\n  inherits: false;\n  initial-value: 0px;\n}\n@property --tw-ring-offset-color {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: #fff;\n}\n@property --tw-ring-offset-shadow {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: 0 0 #0000;\n}\n@property --tw-outline-style {\n  syntax: \"*\";\n  inherits: false;\n  initial-value: solid;\n}\n@property --tw-blur {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-brightness {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-contrast {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-grayscale {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-hue-rotate {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-invert {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-opacity {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-saturate {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-sepia {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-drop-shadow {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-drop-shadow-color {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-drop-shadow-alpha {\n  syntax: \"<percentage>\";\n  inherits: false;\n  initial-value: 100%;\n}\n@property --tw-drop-shadow-size {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-blur {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-brightness {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-contrast {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-grayscale {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-hue-rotate {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-invert {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-opacity {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-saturate {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-backdrop-sepia {\n  syntax: \"*\";\n  inherits: false;\n}\n@property --tw-ease {\n  syntax: \"*\";\n  inherits: false;\n}\n@layer properties {\n  @supports ((-webkit-hyphens: none) and (not (margin-trim: inline))) or ((-moz-orient: inline) and (not (color:rgb(from red r g b)))) {\n    *, ::before, ::after, ::backdrop {\n      --tw-scale-x: 1;\n      --tw-scale-y: 1;\n      --tw-scale-z: 1;\n      --tw-rotate-x: initial;\n      --tw-rotate-y: initial;\n      --tw-rotate-z: initial;\n      --tw-skew-x: initial;\n      --tw-skew-y: initial;\n      --tw-border-style: solid;\n      --tw-ordinal: initial;\n      --tw-slashed-zero: initial;\n      --tw-numeric-figure: initial;\n      --tw-numeric-spacing: initial;\n      --tw-numeric-fraction: initial;\n      --tw-shadow: 0 0 #0000;\n      --tw-shadow-color: initial;\n      --tw-shadow-alpha: 100%;\n      --tw-inset-shadow: 0 0 #0000;\n      --tw-inset-shadow-color: initial;\n      --tw-inset-shadow-alpha: 100%;\n      --tw-ring-color: initial;\n      --tw-ring-shadow: 0 0 #0000;\n      --tw-inset-ring-color: initial;\n      --tw-inset-ring-shadow: 0 0 #0000;\n      --tw-ring-inset: initial;\n      --tw-ring-offset-width: 0px;\n      --tw-ring-offset-color: #fff;\n      --tw-ring-offset-shadow: 0 0 #0000;\n      --tw-outline-style: solid;\n      --tw-blur: initial;\n      --tw-brightness: initial;\n      --tw-contrast: initial;\n      --tw-grayscale: initial;\n      --tw-hue-rotate: initial;\n      --tw-invert: initial;\n      --tw-opacity: initial;\n      --tw-saturate: initial;\n      --tw-sepia: initial;\n      --tw-drop-shadow: initial;\n      --tw-drop-shadow-color: initial;\n      --tw-drop-shadow-alpha: 100%;\n      --tw-drop-shadow-size: initial;\n      --tw-backdrop-blur: initial;\n      --tw-backdrop-brightness: initial;\n      --tw-backdrop-contrast: initial;\n      --tw-backdrop-grayscale: initial;\n      --tw-backdrop-hue-rotate: initial;\n      --tw-backdrop-invert: initial;\n      --tw-backdrop-opacity: initial;\n      --tw-backdrop-saturate: initial;\n      --tw-backdrop-sepia: initial;\n      --tw-ease: initial;\n    }\n  }\n}\n"],["STYLE",{},"/*\n * THE APPLICATION SHELL AND THE SCREEN-SPACE POST STACK.\n *\n * Two jobs live here and they are related.\n *\n * The first is the document itself: a full-bleed WebGPU canvas with a DOM overlay on top,\n * with every browser affordance that would fight an on-rails runner switched off --\n * overscroll bounce, double-tap zoom, text selection, the tap highlight, the context menu\n * on long press. None of those are style preferences; each one is a bug report waiting to\n * be filed about a throw that did not register.\n *\n * The second is the part of the post chain that is CHEAPER IN THE COMPOSITOR THAN IN THE\n * RENDER GRAPH. Vignette, grain and scanlines are full-screen constant-cost operations\n * with no dependence on scene depth or motion vectors. Running them as TSL nodes means a\n * full-resolution read and write of the HDR target per effect, inside the frame budget the\n * shatter simulation is competing for. Running them as three composited DOM layers costs\n * the GPU a blend of three quads it was going to composite anyway, and costs the render\n * graph nothing. The effects that genuinely need scene data -- bloom, GTAO, SSR, TRAA,\n * depth of field, the real per-pixel chromatic aberration -- stay in the render graph\n * where they belong; the layer named `.fx__aberration` below is the wide-angle edge fringe\n * only, and says so where it is defined.\n *\n * PRESETS ARE NOT A LABEL.\n * `[data-preset]` on <html> is written once by main.ts from the resolved tier. Each preset\n * block below has to make the frame genuinely cheaper, which means removing layers from\n * the render tree with `display: none` and removing filters with `filter: none` -- not\n * setting an opacity to zero. A zero-opacity full-screen layer is still composited, a\n * `blur(0px)` is still a filter that allocates a backing surface, and a `will-change`\n * nobody reads is still a compositor layer holding video memory. A preset that only claims\n * to change the render is worthless, so every collapse here is structural.\n */\n\n/* ============================================================ DOCUMENT SHELL */\n@layer base {\n  html {\n    block-size: 100%;\n    background: var(--void-000);\n    color-scheme: dark;\n    /* iOS inflates text in landscape unless told not to, which silently breaks every\n       HUD gutter measurement the moment the phone is rotated. */\n    -webkit-text-size-adjust: 100%;\n    text-size-adjust: 100%;\n  }\n\n  body {\n    margin: 0;\n    min-block-size: 100%;\n    background: var(--void-000);\n    color: var(--ink);\n    font-family: var(--font-ui-stack);\n    -webkit-font-smoothing: antialiased;\n    -moz-osx-font-smoothing: grayscale;\n    /* The page never scrolls: the corridor is the scroll. `overflow: hidden` alone still\n       lets iOS rubber-band the viewport, so overscroll-behavior has to say it too. */\n    overflow: hidden;\n    overscroll-behavior: none;\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  #app {\n    position: fixed;\n    inset: 0;\n    /* A stacking context on the root container, so canvas / fx / overlay order is DOM\n       order and no descendant can escape it with a z-index of its own invention. */\n    isolation: isolate;\n  }\n\n  /*\n   * The canvas is sized in CSS and its backing store is sized by the renderer from\n   * QualityBudget.renderScale. Those are deliberately different numbers -- the drawing\n   * buffer is allowed to be smaller than the element and be upscaled, which is the entire\n   * point of the render-scale ladder -- so nothing here may set width/height attributes.\n   */\n  #stage {\n    position: absolute;\n    inset: 0;\n    inline-size: 100%;\n    block-size: 100%;\n    display: block;\n    /* Without this, a swipe to aim scrolls the page instead and the throw never fires. */\n    touch-action: none;\n    outline: none;\n  }\n\n  #overlay {\n    position: absolute;\n    inset: 0;\n    /* The overlay element itself is inert; ui/Overlay.ts opens `.hit` when the game is\n       paused or in a menu. See the pointer-events gate in ui/Overlay.ts. */\n    pointer-events: none;\n  }\n}\n\n/*\n * NO TOKEN BRIDGE FOR ui/Overlay.ts, DELIBERATELY.\n *\n * Overlay's injected stylesheet declares its `--sp-*` slots as `var(--ink)`, `var(--ice)`\n * and so on, so it reads the tokens above directly and there is exactly one colour system\n * in the app. An earlier bridge here re-pointed a second set of hard-coded defaults; that\n * is the drift this file used to paper over, and the fix was to delete the defaults rather\n * than out-specify them. A var() with nothing behind it inherits, which is what a unit test\n * mounting the overlay with no application CSS should get.\n *\n * `--sp-ui-transition` and `--sp-hud-pulse` are still Overlay's own: it writes those two as\n * inline styles from the resolved MotionRules, and inline beats every rule in this file.\n */\n\n/* ================================================================= BOOT VEIL\n *\n * Present in the HTML rather than created by main.ts, so the first paint after the\n * document parses is already the game's own black instead of a white flash while the\n * module graph downloads. main.ts writes its status line and then removes the node.\n */\n.boot {\n  position: absolute;\n  inset: 0;\n  z-index: 20;\n  display: grid;\n  place-content: center;\n  gap: 14px;\n  justify-items: center;\n  background: var(--void-000);\n  transition: opacity var(--dur-scene) var(--e-out);\n}\n\n.boot[data-state='done'] {\n  opacity: 0;\n  pointer-events: none;\n}\n\n/* A failure re-shows the veil, including one re-attached mid-run after a lost device, so\n   the opacity has to be stated rather than inherited from whatever state it was left in. */\n.boot[data-state='failed'] {\n  opacity: 1;\n  pointer-events: auto;\n}\n\n.boot__word {\n  margin: 0;\n  font-size: clamp(22px, 5vw, 38px);\n  letter-spacing: 0.42em;\n  /* Tracking is applied to the right of every glyph including the last, which visually\n     shifts a centred word left by half a step. */\n  text-indent: 0.42em;\n  color: var(--ink);\n}\n\n.boot__status {\n  margin: 0;\n  font-size: 11px;\n  letter-spacing: 0.16em;\n  text-transform: uppercase;\n  color: var(--ink-faint);\n  text-align: center;\n  max-inline-size: 46ch;\n  text-wrap: balance;\n}\n\n.boot__status[data-tone='fail'] {\n  color: var(--flare);\n}\n\n.boot__bar {\n  inline-size: min(220px, 52vw);\n  block-size: 2px;\n  overflow: hidden;\n  background: rgb(var(--rgb-ice) / 0.14);\n}\n\n.boot__bar::after {\n  content: '';\n  display: block;\n  block-size: 100%;\n  inline-size: 34%;\n  background: var(--ice);\n  /* transform only -- a boot animation that thrashes layout while the WASM and the WebGPU\n     device are both initialising is competing for the exact thread it is reporting on. */\n  animation: boot-sweep 1100ms var(--e-out) infinite;\n  will-change: transform;\n}\n\n@keyframes boot-sweep {\n  from { transform: translate3d(-100%, 0, 0); }\n  to { transform: translate3d(340%, 0, 0); }\n}\n\n.noscript {\n  position: absolute;\n  inset: 0;\n  z-index: 30;\n  display: grid;\n  place-content: center;\n  padding: var(--gutter);\n  background: var(--void-000);\n  color: var(--ink-dim);\n  text-align: center;\n}\n\n/* ============================================================== THE FX STACK\n *\n * One inert container, four sibling layers, painted in DOM order.\n *\n * `.fx` HAS NO z-index AND NO `contain`, AND THAT IS LOAD-BEARING.\n * Two of these layers blend with what is behind them - the aberration screens light onto\n * the frame, the grain modulates its midtones - and `mix-blend-mode` blends against the\n * backdrop of the nearest stacking context, not against the page. A `z-index` on a\n * positioned element creates a stacking context. So does `contain: layout` and so does\n * `contain: paint`. Any of the three would make these layers blend against `.fx`'s own\n * transparent backdrop, which is a no-op: the grain would sit on top as a grey wash and\n * the aberration would stop being additive at all. Both would still LOOK like they were\n * doing something, which is the worst failure mode available.\n *\n * With no stacking context here, the blending group is `#app` (which isolates), the\n * backdrop is the canvas, and paint order falls out of DOM order: canvas, fx, overlay.\n * `overflow: hidden` clips the grain layer's overscan without promoting anything --\n * overflow establishes a block formatting context, never a stacking context.\n *\n * The four intensity knobs are the only things the presets touch, apart from the\n * structural removals further down.\n */\n:root {\n  --fx-vignette: 1;\n  /* Unitless magnification delta, not a pixel offset -- see .fx__aberration. */\n  --fx-ca: 0.006;\n  --fx-scan: 0.03;\n  --fx-grain: 0.03;\n}\n\n.fx {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n  pointer-events: none;\n}\n\n.fx__layer {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n}\n\n/*\n * VIGNETTE. Hand-rolled here rather than in TSL because r185 ships no VignetteNode and a\n * radial darkening of the final image is exactly what a composited gradient is for. The\n * stop sits at 42% so the centre third of the frame -- where the reticle and the next\n * pane always are -- is completely untouched.\n */\n/*\n * FINAL EDGE CRUSH -- paints ABOVE every other fx layer, and that is the whole point.\n *\n * The stack order is vignette, aberration, scanlines, grain. Grain and scanlines are\n * additive overlays, so they re-lift whatever the vignette just darkened: at 0.055 and\n * 0.05 they put a ~7% floor under the entire frame, including the corners. A value\n * structure that calls for sub-6% edges cannot be built under an additive layer, so the\n * border is re-crushed last. A pseudo-element is used rather than a fifth div because it\n * is guaranteed to paint after all children without touching the DOM contract.\n */\n.fx::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: radial-gradient(\n    /* Radii deliberately under 2/3: an ellipse sized to the frame leaves the mid-edges\n       (top-centre, left-centre) inside the transparent zone, which is what held the edge\n       band at 7% while the corners were already black. */\n    ellipse 58% 60% at 50% 47%,\n    transparent 0%,\n    transparent 72%,\n    rgb(0 0 0 / 0.52) 84%,\n    rgb(0 0 0 / 0.96) 92%,\n    rgb(0 0 0 / 1) 100%\n  );\n}\n\n.fx__vignette {\n  /* Ellipse, not farthest-side: on 16:9 a circular stop reaches the short edge first and\n     crushes top and bottom while the sides stay lit. Separate radii track the frame. */\n  background: radial-gradient(\n    ellipse 60% 62% at 50% 47%,\n    transparent 0%,\n    transparent 72%,\n    rgb(3 5 9 / 0.38) 84%,\n    rgb(1 2 4 / 0.92) 90%,\n    rgb(0 0 0 / 1) 100%\n  );\n  opacity: var(--fx-vignette);\n}\n\n/*\n * CHROMATIC ABERRATION -- THE EDGE FRINGE ONLY.\n *\n * This is not the render-graph effect. Per-pixel aberration needs to resample the scene\n * colour along the radial axis, and that is ChromaticAberrationNode's job in the post\n * chain. What a composited layer can honestly contribute is the wide-angle lens artefact\n * that dominates the look: warm and cool fringes that exist only near the corners and\n * grow with radius.\n *\n * The two rings are separated by MAGNIFICATION, not by a lateral offset. Lateral\n * chromatic aberration is a difference in focal length between wavelengths, so the red\n * image is very slightly larger than the blue one and the split is radial -- strongest at\n * the corners, exactly zero on the optical axis. A translate would put an equal fringe on\n * the centre of the frame, where a real lens has none, and would also let the two rings\n * cancel into a plain glow instead of separating into two colours.\n *\n * Kept faint on purpose. Over a lit corridor this reads as a fringe on the bright glass\n * edges that reach the corners; turned up far enough to be obvious over an empty frame it\n * would be a coloured halo over a full one.\n */\n.fx__aberration {\n  mix-blend-mode: screen;\n  opacity: 0.35;\n}\n\n.fx__aberration::before,\n.fx__aberration::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  /* Both rings start well outside the action safe area: nothing the player aims at is\n     ever inside the fringe. */\n  background: radial-gradient(farthest-side at 50% 50%, transparent 72%, var(--fx-ca-tint) 122%);\n}\n\n.fx__aberration::before {\n  --fx-ca-tint: rgb(255 60 100 / 0.28);\n  transform: scale(calc(1 + var(--fx-ca)));\n}\n\n.fx__aberration::after {\n  --fx-ca-tint: rgb(60 190 255 / 0.28);\n  transform: scale(calc(1 - var(--fx-ca)));\n}\n\n/*\n * SCANLINES. The layer is 200% tall and drifts by exactly half its height, so the loop\n * point lands on an identical row of the repeating gradient and the seam is invisible.\n * translate3d, never background-position: the latter repaints the full-screen gradient\n * every frame, the former is a compositor transform on a layer that never repaints at all.\n */\n.fx__scanlines {\n  block-size: 200%;\n  background: repeating-linear-gradient(\n    0deg,\n    rgb(0 0 0 / 0.5) 0px,\n    rgb(0 0 0 / 0.5) 1px,\n    transparent 1px,\n    transparent 3px\n  );\n  opacity: var(--fx-scan);\n  animation: fx-drift var(--dur-loop-slow) linear infinite;\n  will-change: transform;\n}\n\n@keyframes fx-drift {\n  from { transform: translate3d(0, 0, 0); }\n  to { transform: translate3d(0, -50%, 0); }\n}\n\n/*\n * GRAIN. An feTurbulence tile rendered once at decode into a static image -- no filter\n * runs per frame. It is jittered in whole-tile steps so the noise field resamples without\n * ever revealing the tile boundary; `steps()` rather than a smooth curve because grain\n * that slides continuously reads as a moving texture instead of as film.\n *\n * Grain goes last and on `overlay` blend so it modulates midtones without lifting the\n * blacks, which is the difference between film grain and a grey wash over the corridor.\n */\n.fx__grain {\n  inset: -60px;\n  background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='160' height='160' filter='url(%23g)' opacity='0.6'/></svg>\");\n  background-repeat: repeat;\n  mix-blend-mode: overlay;\n  opacity: var(--fx-grain);\n  animation: fx-grain 900ms steps(1, end) infinite;\n  will-change: transform;\n}\n\n@keyframes fx-grain {\n  0% { transform: translate3d(0, 0, 0); }\n  20% { transform: translate3d(-24px, 12px, 0); }\n  40% { transform: translate3d(18px, -20px, 0); }\n  60% { transform: translate3d(-12px, -8px, 0); }\n  80% { transform: translate3d(26px, 16px, 0); }\n  100% { transform: translate3d(0, 0, 0); }\n}\n\n/* =================================================================== PRESETS\n *\n * Written by main.ts as `data-preset` on <html>, from the tier core/Quality.ts resolved.\n * The names are the tier names lowercased with underscores turned into hyphens; the\n * mapping lives in main.ts and nowhere else.\n */\n\n/* ULTRA_4K -- the reference look. Nothing is removed, and the grain is finer because at\n   this pixel density a coarser field reads as dirt on the screen rather than as film. */\n[data-preset='ultra-4k'] {\n  --fx-vignette: 0.58;\n  --fx-ca: 0.0085;\n  --fx-scan: 0.045;\n  --fx-grain: 0.05;\n  --glass-blur: 18px;\n}\n\n[data-preset='desktop-high'] {\n  --fx-vignette: 1;\n  --fx-ca: 0.006;\n  --fx-scan: 0.03;\n  --fx-grain: 0.03;\n  --glass-blur: 14px;\n}\n\n/*\n * MOBILE_HIGH. The blur halves and the scanline layer LEAVES THE TREE rather than fading\n * out: a 1px repeating gradient over a 3x DPR display is a per-pixel pattern the panel\n * cannot resolve, so it costs a full-screen blend to produce moire and nothing else.\n */\n[data-preset='mobile-high'] {\n  --fx-vignette: 0.5;\n  --fx-ca: 0.004;\n  --fx-grain: 0.04;\n  --glass-blur: 8px;\n}\n\n[data-preset='mobile-high'] .fx__scanlines {\n  display: none;\n}\n\n/*\n * MOBILE_LOW -- THE HONEST COLLAPSE.\n *\n * Three of the four layers are removed from the render tree, not dimmed. Every blur in\n * the document is switched off at the source, including ones declared in stylesheets this\n * file has never seen: ui/Overlay.ts, ui/Motion.ts and any future widget module inject\n * their own CSS at runtime, so a preset that only zeroed the tokens it knows about would\n * leave real backdrop-filters running on the exact hardware that cannot afford them.\n *\n * The descendant-universal selector is deliberate and is the reason this preset is worth\n * anything. It is matched once per element at style resolution, not per frame, and it\n * buys a hard guarantee: on MOBILE_LOW there is no backdrop-filter and no filter anywhere\n * in the document. `!important` because the declarations it is overriding are inside\n * injected sheets that load after this one.\n */\n[data-preset='mobile-low'] {\n  --fx-vignette: 0.42;\n  --fx-ca: 0;\n  --fx-scan: 0;\n  --fx-grain: 0;\n  --glass-blur: 0px;\n  /* Opaque, because with the blur gone a translucent panel is just a dark tint over a\n     busy corridor and the text on it stops being readable. */\n  --glass: rgb(9 14 22 / 0.94);\n  --glass-deep: rgb(6 10 16 / 0.97);\n}\n\n[data-preset='mobile-low'] .fx__aberration,\n[data-preset='mobile-low'] .fx__scanlines,\n[data-preset='mobile-low'] .fx__grain {\n  display: none;\n}\n\n[data-preset='mobile-low'] .glass,\n[data-preset='mobile-low'] .sp-overlay,\n[data-preset='mobile-low'] .sp-overlay *,\n[data-preset='mobile-low'] .sp-overlay *::before,\n[data-preset='mobile-low'] .sp-overlay *::after {\n  backdrop-filter: none !important;\n  -webkit-backdrop-filter: none !important;\n  filter: none !important;\n}\n\n/* The halo's soft falloff is a blur, so on this preset it becomes a plain radial gradient\n   rather than `blur(0px)`, which would still allocate a filter surface per haloed element. */\n[data-preset='mobile-low'] .a-halo::before {\n  filter: none;\n}\n\n/* A `will-change` the compositor honours is a promoted layer holding video memory whether\n   or not anything animates. On the tier with the least of it, promote nothing speculatively. */\n[data-preset='mobile-low'] .meter__fill,\n[data-preset='mobile-low'] .fx__scanlines,\n[data-preset='mobile-low'] .fx__grain,\n[data-preset='mobile-low'] .boot__bar::after {\n  will-change: auto;\n}\n\n/*\n * REDUCED MOTION.\n *\n * Independent of the preset axis, exactly as core/Quality.ts models it: a 4090 whose owner\n * asked for stillness keeps every pixel of the ULTRA_4K look and loses only the movement.\n * The two drifting layers stop; nothing is removed, because a motionless grain field is\n * still the correct image.\n *\n * Emitted against the media query AND an explicit attribute, so the preference can be set\n * in-game by a player whose OS was never told, and so it applies before any JS has run.\n */\n@media (prefers-reduced-motion: reduce) {\n  .fx__scanlines,\n  .fx__grain,\n  .boot__bar::after {\n    animation: none !important;\n  }\n}\n\n[data-motion='reduced'] .fx__scanlines,\n[data-motion='reduced'] .fx__grain,\n[data-motion='reduced'] .boot__bar::after {\n  animation: none !important;\n}\n"]],"\n\n  ",["BODY",{},"\n    ",["DIV",{"id":"app"},"\n      ","\n      ",["CANVAS",{"__playwright_bounding_rect__":"{\"left\":0,\"top\":0,\"right\":960,\"bottom\":540}","id":"stage","aria-label":"Game viewport","role":"img"}],"\n\n      ","\n      ",["DIV",{"class":"fx","aria-hidden":"true"},"\n        ",["DIV",{"class":"fx__layer fx__vignette"}],"\n        ",["DIV",{"class":"fx__layer fx__aberration"}],"\n        ",["DIV",{"class":"fx__layer fx__scanlines"}],"\n        ",["DIV",{"class":"fx__layer fx__grain"}],"\n      "],"\n\n      ","\n      ",["DIV",{"id":"overlay"}],"\n\n      ",["DIV",{"id":"boot","class":"boot"},"\n        ",["P",{"class":"boot__word t-display"},"SHATTERPOINT"],"\n        ",["DIV",{"class":"boot__bar","role":"presentation"}],"\n        ",["P",{"class":"boot__status t-ui","id":"boot-status","role":"status","aria-live":"polite"},"Starting the renderer"],"\n      "],"\n\n      ","\n    "],"\n\n    ","\n  \n\n"]],"viewport":{"width":960,"height":540},"timestamp":3804.558,"wallTime":1788344638112,"collectionTime":2.8499999046325684,"resourceOverrides":[],"isMainFrame":true}}
